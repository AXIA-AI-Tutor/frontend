# .codex/rules/default.rules

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "커밋은 Jira 이슈 번호와 커밋 메시지 컨벤션 확인 후 실행해야 합니다.",
    match = [
        "git commit",
        "git commit -m \"KAN-51 chore(common): AI agent 작업 규칙 설정\"",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "commit-msg hook을 우회하면 Jira 커밋 컨벤션이 깨질 수 있습니다.",
    match = [
        "git commit --no-verify",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "-n"],
    decision = "forbidden",
    justification = "commit-msg hook을 우회하면 Jira 커밋 컨벤션이 깨질 수 있습니다.",
    match = [
        "git commit -n",
    ],
)

prefix_rule(
    pattern = ["git", "add", "."],
    decision = "prompt",
    justification = "git add . 은 관련 없는 변경까지 포함할 수 있으므로 변경한 파일만 명시적으로 stage 하세요.",
    match = [
        "git add .",
    ],
)

prefix_rule(
    pattern = ["git", "add", "-A"],
    decision = "prompt",
    justification = "git add -A 는 관련 없는 변경까지 포함할 수 있으므로 변경한 파일만 명시적으로 stage 하세요.",
    match = [
        "git add -A",
    ],
)

prefix_rule(
    pattern = ["git", "add", "--all"],
    decision = "prompt",
    justification = "git add --all 은 관련 없는 변경까지 포함할 수 있으므로 변경한 파일만 명시적으로 stage 하세요.",
    match = [
        "git add --all",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "원격 브랜치 변경은 사용자 확인 후 실행해야 합니다.",
    match = [
        "git push",
        "git push origin HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "강제 push는 원격 이력 손상 위험이 있어 금지합니다.",
    match = [
        "git push --force",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "HEAD", "--force"],
    decision = "forbidden",
    justification = "강제 push는 원격 이력 손상 위험이 있어 금지합니다.",
    match = [
        "git push origin HEAD --force",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "HEAD", "-f"],
    decision = "forbidden",
    justification = "강제 push는 원격 이력 손상 위험이 있어 금지합니다.",
    match = [
        "git push origin HEAD -f",
    ],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "강제 push는 원격 이력 손상 위험이 있어 금지합니다.",
    match = [
        "git push -f",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "prompt",
    justification = "force-with-lease도 원격 이력을 변경할 수 있으므로 실행 전 확인이 필요합니다.",
    match = [
        "git push --force-with-lease",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "PR 생성은 사용자가 명시적으로 요청한 경우에만 수행해야 합니다.",
    match = [
        "gh pr create",
        "gh pr create --fill",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR merge는 팀 운영 정책상 사람이 수동으로 수행합니다.",
    match = [
        "gh pr merge",
    ],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "새 의존성 추가는 package.json과 package-lock.json을 변경하므로 확인이 필요합니다.",
    match = [
        "npm install axios",
        "npm install -D vitest",
    ],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "이 프론트엔드 앱은 npm publish 대상이 아닙니다.",
    match = [
        "npm publish",
    ],
)

prefix_rule(
    pattern = ["npm", "audit", "fix", "--force"],
    decision = "prompt",
    justification = "강제 보안 수정은 의존성 대규모 변경을 만들 수 있어 확인이 필요합니다.",
    match = [
        "npm audit fix --force",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "대량 삭제 명령은 실행 전 확인이 필요합니다.",
    match = [
        "rm -rf .next",
        "rm -rf node_modules",
    ],
)