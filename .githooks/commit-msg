#!/bin/sh
# .githooks/commit-msg

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

# 팀 커밋 컨벤션:
# KAN-1 feat(home): 홈 화면 UI 구현
pattern='^KAN-[0-9]+ (feat|fix|docs|style|refactor|test|chore)\([a-z0-9-]+\): .+'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "잘못된 커밋 메시지입니다."
  echo "형식: KAN-이슈번호 type(scope): 요약"
  echo "예: KAN-51 chore(common): AI agent 작업 규칙 설정"
  exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
branch_issue="$(printf '%s' "$branch" | sed -nE 's#^(feature|fix|chore|hotfix)/(KAN-[0-9]+)-.+#\2#p')"
commit_issue="$(printf '%s' "$first_line" | sed -nE 's/^(KAN-[0-9]+) .+/\1/p')"

if [ -n "$branch_issue" ] && [ "$branch_issue" != "$commit_issue" ]; then
  echo "커밋 메시지의 Jira 이슈 번호가 브랜치명과 일치하지 않습니다."
  echo "브랜치: $branch"
  echo "브랜치 이슈: $branch_issue"
  echo "커밋 이슈: $commit_issue"
  exit 1
fi
